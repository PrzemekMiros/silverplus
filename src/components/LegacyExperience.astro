---
// The downloaded WebGL experience is an opaque legacy bundle.  Loading it only
// on the client preserves its original interaction while Astro renders the shell.
---

<div data-ui="scrollProxy"></div>
<main data-ui="root" class="root" aria-label="Interaktywna prezentacja SilverPlus 2100"></main>

<section id="loading-error" role="alert" aria-labelledby="loading-error-title" hidden>
  <div>
    <h1 id="loading-error-title">Nie udało się wczytać prezentacji</h1>
    <p>Sprawdź połączenie z internetem i spróbuj ponownie. Jeśli problem się powtarza, otwórz stronę w innej przeglądarce.</p>
    <button type="button" id="loading-retry">Spróbuj ponownie</button>
  </div>
</section>
<noscript>Włącz JavaScript w przeglądarce, aby wyświetlić prezentację SilverPlus 2100.</noscript>

<script>
  const errorPanel = document.getElementById('loading-error')!;
  let starting = true;
  const showError = () => {
    starting = false;
    window.clearTimeout(timeout);
    errorPanel.hidden = false;
  };
  const timeout = window.setTimeout(showError, 90_000);
  const onStartupError = () => { if (starting) showError(); };
  window.addEventListener('silverplus:error', showError);
  window.addEventListener('silverplus:ready', () => {
    starting = false;
    window.clearTimeout(timeout);
  }, { once: true });
  window.addEventListener('unhandledrejection', onStartupError);
  window.addEventListener('error', onStartupError);
  document.addEventListener('webglcontextlost', showError, true);
  document.getElementById('loading-retry')!.addEventListener('click', () => window.location.reload());
  const script = document.createElement('script');
  script.src = '/scripts/loader.76ceb4644b28bd9c30b5.js?v=texture-fallback-1';
  script.async = true;
  script.onerror = showError;
  document.body.append(script);
</script>

<style>
  #loading-error:not([hidden]) {
    position: fixed;
    inset: 0;
    z-index: 2147483647;
    display: grid;
    place-items: center;
    padding: 24px;
    overflow: auto;
    background: #101c30;
    color: #edf3f8;
    text-align: center;
  }
  #loading-error > div { max-width: 560px; }
  #loading-error h1 { font-size: 28px; line-height: 1.3; }
  #loading-error p { font-size: 16px; line-height: 1.6; }
  #loading-retry {
    margin-top: 16px;
    padding: 14px 24px;
    border: 0;
    border-radius: 6px;
    background: #83d6cf;
    color: #101c30;
    font-size: 16px;
    cursor: pointer;
  }
  @font-face {
    font-family: 'Poppins';
    src: url('/fonts/Poppins/Poppins-Regular.ttf') format('truetype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Poppins';
    src: url('/fonts/Poppins/Poppins-Bold.ttf') format('truetype');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  :global(body),
  :global(body *),
  :global(body *::before),
  :global(body *::after) {
    font-family: 'Poppins', sans-serif !important;
  }

  :global(html),
  :global(body) {
    width: 100%;
    min-height: 100%;
    margin: 0;
    overflow: hidden;
    background: var(--sp-background);
  }

  .root { position: fixed; inset: 0; }

  :global(.logo) {
    background: transparent url('/silverplus-logo.svg') center / contain no-repeat !important;
    transform: scale(2) !important;
    transform-origin: left center;
  }

  :global(.logo__icon) {
    visibility: hidden;
  }

  /* Zastępuje osadzone logo z oryginalnej paczki przekazanym plikiem SVG. */
  :global(.cortevaLogo) {
    width: 14.5rem !important;
    height: 3.83rem !important;
    background: transparent url('/svg/corteva-logo-replacement.svg') center / contain no-repeat !important;
  }

  :global(.cortevaLogo__icon) {
    visibility: hidden;
  }

  :global(.title),
  :global(.title2),
  :global(.title3),
  :global(.menu__navTitle),
  :global(.btnMain),
  :global(.linkExternal) {
    font-family: 'Poppins', sans-serif !important;
    font-weight: 700 !important;
  }

  :global(.menu__buttons .btnMain:nth-child(2)),
  :global(.menu__buttons .linkExternal) {
    display: flex !important;
    width: 100% !important;
    justify-content: center !important;
    align-items: center !important;
    text-align: center !important;
  }

  :global(.menu__footerLink:nth-of-type(4)) {
    display: none !important;
  }

  /* Te trzy widoki są wbudowane w oryginalną prezentację. Formularze zostały
     zastąpione treścią produktową, zachowując jej natywną nawigację. */
  :global(.signup__form),
  :global(.contact__formMain),
  :global(.contact__noResults),
  :global(.contact__spinner) {
    display: none !important;
  }

  :global(.legal__inner) {
    max-width: 90vw;
  }

  :global(.product-caution-title),
  :global(.product-caution-copy) {
    max-width: 70rem;
    margin: 0 auto 2.4rem;
    text-align: center;
    line-height: 1.45;
    font-size: clamp(1.6rem, 1.5vw, 2.4rem);
  }

  :global(.product-caution-title) {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    font-size: clamp(2.4rem, 2.5vw, 4rem);
  }
</style>
